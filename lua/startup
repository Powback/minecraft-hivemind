-- FIRST LINE, UNCONDITIONAL, NO DEPENDENCIES. A breadcrumb for "did startup run at all?"
--
-- MainFrame spent hours powered ON while writing nothing anywhere -- no MainFrame.log, no
-- mf-boot.txt, no last-run.txt -- which is indistinguishable from a computer that never ran its
-- bootloader, a bootloader that died before its first Log(), and a module that exited to a shell
-- prompt. Those need completely different fixes and nothing on disk could tell them apart.
--
-- Deliberately before EVERYTHING: no Log (not defined yet), no shell, no PowNet, no label lookup.
-- If this file is missing after a power cycle, /startup itself never executed.
pcall(function()
    local h = fs.open("/boot-stage.txt", "w")
    if h then h.write("stage=entered-startup label=" .. tostring(os.getComputerLabel())
                      .. " at=" .. tostring(os.time()) .. "\n") h.close() end
end)

local s_Label = os.getComputerLabel()
if(s_Label == nil and fs.exists("disk/startup")) then
    print("Copying Startup Data.")
    fs.delete("/startup")
    fs.delete("/PowNet")
    fs.copy("disk/startup", "/startup")
    fs.copy("disk/PowNet", "/PowNet")

    if (s_Label == nil) then
        print("Please set the label to the module you want")
    end
    return
end

local monitor
-- _G on purpose: CC:T gives every program its own environment, so a plain global here is
-- invisible to the module we shell.run below. MainFrame.lua's first statement is Log("Loading...")
-- and it died on a nil call — silently, because shell.run catches the error itself.
function _G.Log(p_Message, p_Color)
    print(p_Message)
    -- The last line painted on the monitor, kept so PowNet.Status can report it. CC monitors are
    -- write-only -- there is no API to read back what is on one -- so remembering what we wrote is
    -- the only way anything outside the game can know what the screen says.
    _G.LAST_LOG = tostring(p_Message)
    -- Also to a file, because a CC terminal cannot be read from outside the game. Without this a
    -- module is completely opaque: StorageMan sat with smelting on, a furnace found, and a chest
    -- full of coal, failing to move it, and there was no way to see the reason it printed.
    -- Truncates rather than growing without bound -- these are diagnostics, not an audit trail.
    pcall(function()
        local s_Name = (os.getComputerLabel() or "module") .. ".log"
        if fs.exists(s_Name) and fs.getSize(s_Name) > 32768 then fs.delete(s_Name) end
        local h = fs.open(s_Name, "a")
        if h then
            h.writeLine(("%s %s"):format(tostring(os.clock()), tostring(p_Message)))
            h.close()
        end
    end)
    -- THE STATION SCREEN IS THIS MODULE'S OWN LOG, NATIVELY. Whatever monitor is attached on any
    -- side (peripheral.find; "left" only matched two of the seven stations) shows the last lines
    -- of this log at text scale 0.5, and the same lines go to /screen.json in this computer's folder
    -- of the world save, where the world viewer reads them -- no HQ in the loop (the user,
    -- 2026-09-08). Rate-limited: a module that logs in bursts repaints at most every 2 game-seconds.
    _G.LOG_RING = _G.LOG_RING or {}
    LOG_RING[#LOG_RING + 1] = ("%s %s"):format(tostring(math.floor(os.clock())), tostring(p_Message))
    if #LOG_RING > 40 then table.remove(LOG_RING, 1) end
    if _G.SCREEN_MON == nil then
        local ok, m = pcall(peripheral.find, "monitor")
        _G.SCREEN_MON = (ok and m) or false
    end
    local s_Now = os.clock()
    if SCREEN_MON and (_G.SCREEN_AT == nil or s_Now - _G.SCREEN_AT >= 2) then
        _G.SCREEN_AT = s_Now
        pcall(function()
            local m = SCREEN_MON
            m.setTextScale(0.5)
            local w, h = m.getSize()
            m.setBackgroundColour(colors.black) m.clear()
            m.setCursorPos(1, 1) m.setTextColour(colors.yellow)
            m.write((tostring(os.getComputerLabel() or "module") .. "  #" .. os.getComputerID()):sub(1, w))
            m.setTextColour(p_Color or colors.white)
            local s_First = math.max(1, #LOG_RING - (h - 1) + 1)
            local row = 2
            for i = s_First, #LOG_RING do
                m.setCursorPos(1, row) m.write(LOG_RING[i]:sub(1, w)) row = row + 1
            end
            m.setTextColour(colors.white)
        end)
        pcall(function()
            local h = fs.open("/screen.json", "w")
            if h then
                h.write(textutils.serialiseJSON({label = os.getComputerLabel(), id = os.getComputerID(),
                    lines = LOG_RING, updated = os.epoch("utc")}))
                h.close()
            end
        end)
    end
end

