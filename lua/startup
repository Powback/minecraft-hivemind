SetStatus("Booting...")

--MainFrame only
--
-- SAME TREATMENT AS EVERY OTHER MODULE: SURFACE THE ERROR, AND ALWAYS REBOOT.
--
-- This used to be shell.run() followed by a bare `return`, and it cost a full day of
-- misdiagnosis. Two separate faults in three lines:
--
--   * shell.run CATCHES the program's error itself and returns false, so a MainFrame dying on its
--     first line was indistinguishable from one exiting cleanly. The rest of this file already
--     knows this -- it uses loadfile+pcall precisely because "shell.run always reports success and
--     tells you nothing" -- and MainFrame, the one module whose failure stops the settlement, was
--     the one still using it.
--   * No os.reboot(). Every other module reboots when it exits; MainFrame returned to a shell
--     prompt and sat there. Powered ON, executing NOTHING, hosting nothing.
--
-- That last state is invisible to every check that exists: `computercraft dump` reports On, the
-- watchdog sees On and does nothing, and HQ can only say "unreachable", which reads like
-- congestion. It was found by noticing MainFrame was ABSENT from `computercraft track` while all
-- six other modules were executing -- and confirmed by MainFrame.log ending at "Connected!" with
-- nothing after it.
--
-- Every unexplained "MainFrame switched off" today was this. It never switched off.
if(s_Label == "MainFrame") then
    pcall(function()
        local h = fs.open("/boot-stage.txt", "a")
        if h then h.write("stage=mainframe-branch\n") h.close() end
    end)
    shell.setDir("disk")
    -- shell.run, NOT loadfile+pcall -- AND I BROKE THIS ONCE ALREADY.
    --
    -- Swapping to loadfile to surface the error looked like a strict improvement (it is what every
    -- other module does, and shell.run famously swallows errors). It is not, HERE. shell.run
    -- launches the program the way CC expects, alongside the rednet daemon that answers
    -- rednet.lookup; running it inline inside startup's own context left MainFrame hosting but
    -- never replying to lookups. Every module in the row then sat in "Waiting for MainFrame...
    -- (10/10) -- rebooting to try again" while MainFrame was demonstrably up, hosted, and in its
    -- parallel loop. shell.setDir also applies to shell.run and not to loadfile, so the swap
    -- quietly changed which file ran as well.
    --
    -- Keep the launch exactly as it was. The genuine bug was never the launcher -- it was the bare
    -- `return` below, which left the computer at a shell prompt: powered ON, hosting nothing,
    -- invisible to every check. That is what os.reboot() fixes, and it is the only change here.
    local s_Ok = shell.run("MainFrame.lua")
    pcall(function()
        local h = fs.open("/last-run.txt", "w")
        h.write(("module=MainFrame shell.run=%s at=%s\n"):format(tostring(s_Ok), tostring(os.time())))
        h.close()
    end)
    Log("MainFrame exited -- rebooting rather than sitting at a shell", colors.red)
    os.sleep(3)
    os.reboot()
end


os.loadAPI("PowNet")
local s_Started, s_Message = PowNet.InitServer()
if not s_Started then
    -- Persist it. A bootloader that prints and returns leaves a computer that looks perfectly
    -- healthy from outside -- On=Y, every file present, no error anywhere -- while it hosts
    -- nothing and answers nothing.
    print("Failed to initialize:")
    print(s_Message)
    local h = fs.open("/FATAL.txt", "w")
    if h then h.write("init failed: " .. tostring(s_Message) .. "\n") h.close() end
    SetStatus("INIT FAILED", colors.red)
    return
end



SetStatus("Connecting...")

-- NAME THE MISSING RADIO. "COULD NOT REACH MAINFRAME" IS A SYMPTOM, NOT A DIAGNOSIS.
--
-- DockingMan sat in the retry-and-reboot loop below for a full DAY. Every diagnostic said it was
-- healthy: `computercraft dump` reported On, every file was present and parsed, `track` showed it
-- executing, InitServer() returned success, and it wrote no FATAL.txt. The one thing wrong with it
-- was invisible from inside the game and from outside it: the wireless modem above the computer
-- was missing, alone among the seven modules in the row.
--
-- InitServer() succeeded anyway, which is what made this so expensive -- the WIRED modem opens
-- rednet perfectly well, so every check for "is rednet up" passed. But a wired modem only reaches
-- computers on its own cable, MainFrame is not on that cable, and rednet.lookup broadcasts into a
-- network that physically cannot carry the question. Hours went into modem archaeology, and the
-- answer was that there was no modem to do archaeology on.
--
-- So: rednet being open is not the same as being able to REACH anyone. Say which kind we have.
local s_Wireless = false
for _, s_Side in ipairs(peripheral.getNames()) do
    if peripheral.getType(s_Side) == "modem" then
        local ok, wireless = pcall(peripheral.call, s_Side, "isWireless")
        if ok and wireless then s_Wireless = true end
    end
end
if not s_Wireless then
    Log("NO WIRELESS MODEM -- this module can only talk over its cable, and MainFrame is not on it. "
        .. "Place a wireless modem on the computer; a wired one is not a substitute.", colors.red)
    local h = fs.open("/NO-RADIO.txt", "w")
    if h then
        h.write("rednet is open on a WIRED modem only. rednet.lookup cannot reach MAINFRAME.\n")
        h.close()
    end
end

-- _G, for the same reason as Log above: every module reads DATA as a global, and a plain
-- assignment here lands in startup's own environment where shell.run cannot see it. DroneMan's
-- Init() indexes DATA["lastDrone"] and dies on nil before it ever hosts.
_G.DATA = nil
-- Wait for MainFrame instead of rebooting on the first failure.
--
-- A fleet reload drops everything at once, so on the way back up a module reliably beat MainFrame
-- to the punch, failed to connect, and rebooted -- over and over, at full speed, looking "on" the
-- whole time. StorageMan sat in exactly this loop and never pulled its own module.
PowNet.WaitForService("MAINFRAME", 120)
s_Connected, _G.DATA = PowNet.Connect()

-- Log, NOT SetStatus. SetStatus paints the monitor and prints to a terminal nobody can read from
-- outside the game; Log also writes the file. A module that cannot reach MainFrame retries ten
-- times, reboots, and does it again for ever -- roughly every 160 seconds -- and every word of that
-- went to a screen. DockingMan sat in this loop for a full day: `computercraft dump` said On,
-- every file was present and parsed, `track` showed it executing, and it wrote NOTHING. Hours went
-- into modem archaeology and file diffs before the loop itself was even a suspect.
--
-- A bootloader that cannot start must say why somewhere durable, or it is indistinguishable from a
-- computer that is simply idle.
local s_Tries = 0
while not s_Connected and s_Tries < 10 do
    Log(("Waiting for MainFrame... (%d/10)"):format(s_Tries + 1), colors.orange)
    os.sleep(3)
    s_Tries = s_Tries + 1
    s_Connected, _G.DATA = PowNet.Connect()
end

if not s_Connected then
    -- Reboot only after genuinely giving up, so the loop is slow and legible rather than a
    -- spin that hides the problem.
    Log("Offline! could not reach MainFrame -- rebooting to try again", colors.red)
    os.sleep(10)
    os.reboot()
end

SetStatus("Updating")

--MapServer only
if(s_Label == "MapServer") then
    PowNet.UpdateModule("PowGPSServer.lua", "PowGPSServer")
    -- MapRender too, and for the same reason: MapServer does os.loadAPI on both at its very first
    -- line, so anything it fetches itself arrives one boot too late to be loadable.
    PowNet.UpdateModule("MapRender.lua", "MapRender")
    print("Updated GPS server")
end


-- SAY WHICH FILE, BEFORE FETCHING IT.
--
-- These three pulls are network calls to MainFrame, and a module that hangs in one of them stops
-- here for ever: connected, executing, and completely silent, because everything around it reports
-- through SetStatus (screen only). DockingMan sat exactly here for a day while `computercraft dump`
-- said On and `track` showed it running -- and there was no way to tell a hung update from a module
-- that had simply not been asked to do anything.
--
-- Naming the file BEFORE the call is the whole point: the last line in the log is then the one that
-- did not come back.
Log("update: fetching startup")
PowNet.UpdateModule("startup")
Log("update: fetching PowNet")
PowNet.UpdateModule("PowNet")
Log("update: fetching " .. tostring(s_Label) .. ".lua")
PowNet.UpdateModule(s_Label .. ".lua")
Log("update: done, launching " .. tostring(s_Label))
SetStatus("Launching!", colors.green)
-- Record WHY a module stopped. shell.run swallows the error and prints it to a terminal nobody
-- is looking at, so a module that dies on its first line is indistinguishable from one that ran
-- and exited — both just reboot. Writing it down is the difference between debugging this in
-- minutes and guessing at it.
-- loadfile + pcall, NOT shell.run. shell.run catches a program's error itself and returns false,
-- so wrapping it in pcall always reports success and tells you nothing — which is exactly how I
-- spent an hour believing DroneMan "ran and exited cleanly" when it may have been erroring on its
-- first line. This surfaces the real message.
local s_Fn, s_LoadErr = loadfile(s_Label .. ".lua", nil, _ENV)
local s_Ok, s_Err
if s_Fn then
  s_Ok, s_Err = pcall(s_Fn)
else
  s_Ok, s_Err = false, "loadfile: " .. tostring(s_LoadErr)
end
do
  local h = fs.open("/last-run.txt", "w")
  h.write(("module=%s ok=%s err=%s at=%s\n"):format(
    tostring(s_Label), tostring(s_Ok), tostring(s_Err), tostring(os.time())))
  h.close()
end
SetStatus("Disconnected!", colors.red)

-- THE REBOOT MUST HAPPEN, WHATEVER ELSE FAILS.
--
-- This write-back used to run unguarded, and the single most common reason a module stands down
-- is a fleet update -- which is precisely when MainFrame is also restarting. So MAINFRAME is nil,
-- sendAndWaitForResponse throws, and the bootloader dies HERE, before os.reboot(). The computer
-- stays powered on, sitting at a shell prompt, hosting nothing.
--
-- That is the worst possible failure shape: `computercraft dump` shows it as on, it answers no
-- rednet, and every "did my update deploy?" check reports a module that is simply absent. Hours
-- went into chasing this as a deploy race when it was a missing pcall.
--
-- Losing the write-back costs telemetry that is re-derived within 30s. Not rebooting costs the
-- module entirely, until someone notices and power-cycles it by hand.
local s_Saved
local s_Ok, s_Err = pcall(function()
    local s_Message = PowNet.newMessage(PowNet.MESSAGE_TYPE.SET, s_Label, _G.DATA)
    s_Saved = PowNet.sendAndWaitForResponse(-1, s_Message, PowNet.SERVER_PROTOCOL)
end)
if not s_Ok then
    print("write-back failed (" .. tostring(s_Err) .. ") -- rebooting anyway")
end
print("EXITED saved=" .. tostring(s_Saved))
os.sleep(3)
os.reboot()