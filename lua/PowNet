function control()
    while true do
        local event, key = os.pullEvent("key")
        if key == keys.backspace then
            break
        end
    end
end

function InitServer()
    -- Report the real reason rather than letting a rednet call throw somewhere further down.
    if NO_REDNET then return false, NO_REDNET end
    print(MODULENAME)
    -- ALWAYS host. rednet.host is idempotent and simply replaces the entry, so a stale
    -- registration is not a reason to refuse to start.
    --
    -- This used to `return false` whenever the lookup found any other host, and the bootloader
    -- responds to that by printing and RETURNING -- which leaves the computer powered on, hosting
    -- nothing, answering nothing, and never writing last-run.txt. It looks completely healthy
    -- from outside: "On | Y", files present, no error anywhere. TaskMan sat like that with the
    -- whole fleet unable to receive work, and every check said it was fine.
    --
    -- A module refusing its own name because something answered a lookup is strictly worse than
    -- taking the name back: at worst two hosts briefly disagree, at best the fleet keeps working.
    local s_Host = rednet.lookup(SERVER_PROTOCOL, MODULENAME)
    local s_Me = (os.computerID and os.computerID()) or os.getComputerID()
    if s_Host and s_Host ~= s_Me then
        print("taking over " .. tostring(MODULENAME) .. " from #" .. tostring(s_Host))
    end
    rednet.host(SERVER_PROTOCOL, MODULENAME)
    return true
end

