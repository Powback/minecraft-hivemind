REDNET_TIMEOUT = 1
--===== SET REDNET PROTOCOL =====--
SERVER_PROTOCOL = "PowNet:Server"
DRONE_PROTOCOL = "PowNet:Drone"

MODULENAME = os.getComputerLabel()
MESSAGE_TYPE = {
    GET = 0,
    SET = 1,
    INIT = 2,
    REGISTER = 3,
    UPDATE = 4,
    CALL = 5,
    -- A REPLY IS NOT A REQUEST, and until now the wire could not tell them apart.
    --
    -- A server answers by mutating the message it was sent -- setting .status and .data -- and
    -- sending the SAME object back. dataKey stays "Heartbeat" and type stays CALL, so to any
    -- receiver it is indistinguishable from a fresh incoming call. Every drone runs PowNet.main
    -- alongside its own request/response code, so both coroutines see the reply: one correctly
    -- treats it as an answer, the other tries to DISPATCH it and prints
    --
    --     No handler for "Heartbeat" (type 5) on D2
    --
    -- On a drone that is only noise, because drones implement none of the server verbs. On a MODULE
    -- it is worse than noise: a reply whose dataKey matches a verb that module implements gets
    -- executed a second time, with the reply's payload, as though a peer had asked for it.
    RESPONSE = 6
}
local m_ServerEvents = {}
local m_DroneEvents = {}
local m_Update

--===== OPEN REDNET =====--
--
-- A MODEM THAT IS NOT READY YET IS NOT A MISSING MODEM.
--
-- This looked exactly once, at load time, and treated "no modem right now" as permanent. But a
-- computer boots the instant its chunk loads, and the modem beside it is a separate block whose
-- peripheral attaches on its own schedule. Lose that race -- server restart, chunk reload, world
-- load, a redeploy that reboots everything at once -- and the module writes FATAL.txt and is dead
-- for good, with the modem sitting right there, attached, milliseconds later.
--
-- Measured: MainFrame's FATAL.txt read "no modem attached to MainFrame", while the world had a
-- wireless_modem_normal directly above it at -484,65,76, facing down, identical in every blockstate
-- to DroneMan's and MapServer's working ones. Turning MainFrame on by hand, changing nothing else,
-- attached it immediately and cleared the fault.
--
-- The cost of losing that race is the whole settlement. MainFrame hosts PowNet, so a dead MainFrame
-- means every module sits in WaitForService("MAINFRAME") and every drone stands down -- which is
-- what "all the modules keep going offline" actually was. Nothing retried, because nothing here
-- believed a modem could arrive late.
--
-- So wait for it. `peripheral` fires on attach, and the timer bounds the wait so a genuinely
-- modem-less computer still reports the hard fault below instead of hanging at boot for ever.
local MODEM_WAIT = 15

local function openAnyModem()
    for _, side in ipairs(redstone.getSides()) do
        if peripheral.getType(side) == "modem" then
            rednet.open(side)
        end
    end
    return rednet.isOpen()
end

if not openAnyModem() then
    local s_Until = os.clock() + MODEM_WAIT
    os.startTimer(1)
    while os.clock() < s_Until do
        local s_Event = os.pullEvent()
        -- "peripheral" is the attach we are waiting for; the timer is the fallback for a modem that
        -- was already in place before this computer started listening.
        if s_Event == "peripheral" or s_Event == "timer" then
            if openAnyModem() then break end
            os.startTimer(1)
        end
    end
end

-- A missing modem is a hard fault and must SAY SO. It used to `return` here, which is the worst
-- possible response: an early return leaves every function below this line undefined, so the
-- caller dies on "attempt to call field 'InitServer' (a nil value)" -- an error that names the
-- wrong thing, three layers from the cause. TaskMan sat dead for hours like that, powered on with
-- every file present, while the whole fleet could not be given work.
--
-- So: record it, make it visible from OUTSIDE the game (a CC terminal cannot be read from the
-- host), and carry on defining the API so callers get a description instead of a nil.
NO_REDNET = nil
if not rednet.isOpen() then
    NO_REDNET = "no modem attached to " .. tostring(os.getComputerLabel() or os.getComputerID())
                .. " -- rednet cannot open, so this computer can neither host nor be called"
    printError(NO_REDNET)
    local h = fs.open("/FATAL.txt", "w")
    if h then
        h.write(NO_REDNET .. "\nAttach a modem to this computer and reboot it.\n")
        h.close()
    end
    local m = peripheral.find("monitor")
    if m then
        pcall(function()
            m.setBackgroundColour(colors.red) m.clear()
            m.setCursorPos(1, 1) m.setTextColour(colors.white)
            m.write("NO MODEM")
        end)
    end
end

-- CACHE THE LOOKUP. It is a network round trip, not a table read.
--
-- rednet.lookup broadcasts a query and waits up to two seconds for hosts to answer, and this was
-- called on EVERY send addressed by name -- every heartbeat, every path request, every observation
-- upload, from every drone. Fourteen drones therefore kept a continuous broadcast storm running
-- just to re-discover module ids that had not changed since boot, and when a lookup happened to
-- time out under that load, Send returned false and the drone reported "no answer from DroneMan"
-- about a module that was up, idle and perfectly healthy.
--
-- Module ids are stable for the life of a world -- they are computer ids -- so this is safe to keep
-- until something proves it wrong. Forget() is that proof: a failed exchange drops the entry and
-- the next call re-resolves, so a module that genuinely moves is picked up on the next attempt
-- rather than cached wrong for ever.
-- Cached with a TTL, NOT for ever.
--
-- A permanent cache was the first attempt and it is wrong: module ids are stable only while nothing
-- restarts, and this fleet restarts constantly. A stale entry sends every subsequent message to the
-- wrong computer, which answers "No handler for GetPath" -- a module that is up, reachable and
-- simply not the one being addressed. Re-resolving once a minute keeps essentially all of the
-- traffic saving (a drone sends many messages a second, not many a minute) while guaranteeing the
-- fleet heals itself within a minute of anything moving.
local m_Hosts = {}
local HOST_TTL = 60

function Lookup(p_Name)
    local s_Entry = m_Hosts[p_Name]
    if s_Entry ~= nil and (os.clock() - s_Entry.at) < HOST_TTL then return s_Entry.id end
    local s_ID = rednet.lookup(SERVER_PROTOCOL, p_Name)
    if s_ID ~= nil then m_Hosts[p_Name] = {id = s_ID, at = os.clock()} end
    return s_ID
end

--- Note a failed exchange. Deliberately does NOT drop the cached id.
---
--- Dropping it meant every failed call bought a fresh rednet.lookup, and rednet.lookup is a
--- network-wide broadcast that waits two seconds for replies. While a module is DOWN every call
--- against it fails, so twenty-three drones each generated a continuous stream of broadcasts
--- looking for something that was not there -- and that traffic is what stalled the drones
--- themselves, mid-job, with their coroutines waiting on a saturated channel. One module being
--- unavailable took the whole fleet down with it.
---
--- The TTL above already re-resolves every sixty seconds, which is all that a module genuinely
--- moving would need. Failure is not evidence that an id is wrong; it is usually evidence that the
--- module is busy or restarting, and the id will be correct again shortly.
function Forget(p_Name)
end

function Connect(p_Module)
    MAINFRAME = rednet.lookup(SERVER_PROTOCOL, "MAINFRAME")
    if not MAINFRAME then
        print("Failed to connect to MainFrame")
        return false
    end
        -- Initialize our data for faster lookup
    if(p_Module == nil) then
        p_Module = MODULENAME
    end
    local s_Message = PowNet.newMessage(MESSAGE_TYPE.INIT, p_Module)
    local s_Response = PowNet.sendAndWaitForResponse(MAINFRAME, s_Message, PowNet.SERVER_PROTOCOL)
    if s_Response then
        return true, s_Response
    else
        print("Failed to fetch data")
        return false
    end
end

function newMessage(messageType, dataKey, data)
    return {
        type = messageType,
        ID = math.random(0, 2^30),
        dataKey = dataKey,
        data = data,
    }
end

----------------------------------------------------------------------------------------------
-- Faults: make friction visible instead of losing it
----------------------------------------------------------------------------------------------
-- Nearly every hour lost building this fleet went to something failing silently: a fuel transfer
-- that moved zero items, a module lookup returning nil, a module overwritten with 0 bytes, an
-- order that reported "queued" and never left HQ. In every case the code HAD the reason and threw
-- it away -- usually a bare pcall whose result was discarded.
--
-- Failures are therefore RECORDED, not merely printed: a CC terminal cannot be read from outside
-- the game, so a print nobody sees is the same as no error at all.
--
-- DEPLOYMENT RULE, learned the hard way: ship this file FIRST and reboot everything twice, THEN
-- ship module code that calls Try/Fault. The bootloader does os.loadAPI("PowNet") BEFORE
-- UpdateModule("PowNet"), so on the boot where a module first pulls new code it is still running
-- the OLD PowNet -- and a module calling a brand-new PowNet function dies with
-- "attempt to call field 'Try' (a nil value)" while that function is plainly in the file on disk.
local m_Faults = {}
local FAULT_KEEP = 40

function Fault(p_Where, p_Err)
    local s_Entry = {
        module = MODULENAME,
        where  = tostring(p_Where),
        err    = tostring(p_Err),
        clock  = os.clock(),
    }
    m_Faults[#m_Faults + 1] = s_Entry
    while #m_Faults > FAULT_KEEP do table.remove(m_Faults, 1) end
    if _G.Log then _G.Log("FAULT " .. s_Entry.where .. ": " .. s_Entry.err)
    else print("FAULT " .. s_Entry.where .. ": " .. s_Entry.err) end
    return false, s_Entry.err
end

-- pcall that does not swallow. Use instead of a bare pcall wherever the failure matters.
function Try(p_Where, p_Fn, ...)
    local s_Ok, s_Res = pcall(p_Fn, ...)
    if not s_Ok then Fault(p_Where, s_Res) end
    return s_Ok, s_Res
end

function GetFaults() return m_Faults end
function ClearFaults() m_Faults = {} return true end

----------------------------------------------------------------------------------------------
-- Status: what this computer is, where it is, and what it last said
----------------------------------------------------------------------------------------------

-- Tail of this module's own log file.
--
-- startup's Log() already writes every line to <label>.log precisely because a CC terminal cannot
-- be read from outside the game. Nothing could read it back, so the record existed and helped
-- nobody. Reading is bounded by BYTES, not lines: these files are truncated at 32KB and a module
-- that has been up for a day has thousands of lines, none of which are worth shipping over rednet.
local LOG_TAIL_BYTES = 1200
local function logTail(p_Lines)
    p_Lines = p_Lines or 6
    local s_Out = {}
    pcall(function()
        local s_Name = (os.getComputerLabel() or "module") .. ".log"
        if not fs.exists(s_Name) then return end
        local s_Size = fs.getSize(s_Name)
        local h = fs.open(s_Name, "r")
        if not h then return end
        -- No seek on a CC read handle, so skip forward instead of holding the whole file: a 32KB
        -- string built line by line on a computer with this little memory is worth avoiding.
        local s_Skip = math.max(0, s_Size - LOG_TAIL_BYTES)
        local s_Seen = 0
        local s_Ring = {}
        for line in h.readLine do
            s_Seen = s_Seen + #line + 1
            if s_Seen >= s_Skip then
                s_Ring[#s_Ring + 1] = line
                if #s_Ring > p_Lines then table.remove(s_Ring, 1) end
            end
        end
        h.close()
        s_Out = s_Ring
    end)
    return s_Out
end

-- Where this computer physically is.
--
-- A non-turtle has no pgps and no cached position, so the only answer available is the GPS
-- constellation MapServer already hosts -- which is also why this is best-effort. A computer
-- without a wireless modem, or one outside the constellation's range, legitimately does not know
-- where it is, and saying nil is the correct answer. Guessing would put a marker on a map that
-- looks exactly as authoritative as a real one.
--
-- The timeout is short on purpose: gps.locate blocks, and this runs inside the receive loop while
-- a caller is counting down a rednet timeout.
local m_Pos, m_PosAt = nil, -1000
local function locate()
    -- Cached hard. A computer does not move, so re-locating costs a GPS round trip to answer a
    -- question whose answer cannot have changed.
    if m_Pos ~= nil or (os.clock() - m_PosAt) < 60 then return m_Pos end
    m_PosAt = os.clock()
    local s_Ok, x, y, z = pcall(gps.locate, 1)
    if s_Ok and x then m_Pos = {x = x, y = y, z = z} end
    return m_Pos
end

function Status()
    local s_Faults = GetFaults()
    return {
        module   = MODULENAME,
        id       = os.getComputerID(),
        label    = os.getComputerLabel(),
        pos      = locate(),
        -- Seconds since this computer booted. A module that answers with a tiny uptime is a
        -- module that has been crash-looping, which no other field would reveal.
        up       = os.clock(),
        faults   = #s_Faults,
        lastFault = s_Faults[#s_Faults],
        -- What the monitor is showing, for the modules that drive it through Log(). NOT readable
        -- in general: CC monitors are write-only, there is no API to read back what was painted,
        -- so a module that draws its own dashboard (MainFrame, MapServer) cannot be mirrored --
        -- only the modules whose display IS their last Log line.
        monitor  = _G.LAST_LOG,
        log      = logTail(6),
    }
end

-- Find this computer's display. Reimplemented in six modules, each slightly differently: some
-- wrapped a fixed side once at load and died on the first Render if nothing was there, some
-- searched every time. "left" is the VIEWER's left, not the computer's, so a fixed side is also
-- wrong as soon as a computer is placed facing another way.
--
-- Searches, tolerates having no monitor, and falls back to the terminal so a module without a
-- screen still runs instead of crashing.
local m_TermShim
function Monitor(p_PreferredSide)
    if p_PreferredSide then
        local ok, s_Type = pcall(peripheral.getType, p_PreferredSide)
        if ok and s_Type == "monitor" then
            local ok2, m = pcall(peripheral.wrap, p_PreferredSide)
            if ok2 and m then return m end
        end
    end
    local ok, m = pcall(peripheral.find, "monitor")
    if ok and m then return m end
    -- NO MONITOR IS NOT A REASON FOR A MODULE TO DIE.
    --
    -- Falling back to `term` looked safe and was not: term has no setTextScale, so DroneMan and
    -- DockingMan both died on their first render with "attempt to call field 'setTextScale' (a nil
    -- value)". Their guard -- `local m = monitor() if not m then return end` -- never fired, because
    -- term is perfectly truthy. Two modules that route drones and allocate docks were killed by not
    -- having a screen to draw on.
    --
    -- So the fallback answers the whole monitor interface: everything term can do, plus a no-op for
    -- the handful of methods only a real monitor has. A module with no monitor now prints to its own
    -- terminal and keeps working.
    if not m_TermShim then
        m_TermShim = setmetatable(
            {setTextScale = function() end, getTextScale = function() return 1 end},
            {__index = term})
    end
    return m_TermShim
end

function RegisterEvents( p_ServerEvents, p_DroneEvents, p_Update )
    p_ServerEvents = p_ServerEvents or {}
    -- Every module answers "what has gone wrong here" without each one remembering to implement
    -- it. Friction nobody can query is friction nobody fixes.
    p_ServerEvents["Faults"] = {
        func = function() return true, {module = MODULENAME, faults = GetFaults()} end
    }
    p_ServerEvents["ClearFaults"] = {
        func = function() ClearFaults() return true, {module = MODULENAME, cleared = true} end
    }
    -- "Where is this computer and what is it saying?" -- registered for every module for the same
    -- reason Faults is: a diagnostic each module has to remember to implement is one most of them
    -- will not have.
    --
    -- The fleet's non-turtle computers were completely invisible from outside the game. Drones
    -- report position and status on a heartbeat; MainFrame, MapServer, TaskMan, StorageMan and
    -- DockingMan report nothing at all, so the map could draw the machines that dig and not the
    -- ones that decide. You could see five turtles idling and have no way to tell whether that was
    -- because there was no work or because TaskMan had been sitting dead since the last reboot.
    p_ServerEvents["Status"] = { func = function() return true, Status() end }
    m_ServerEvents = p_ServerEvents
    m_DroneEvents = p_DroneEvents
    m_Update = p_Update

    for k,v in pairs(p_ServerEvents) do
        if(type(v) == "table" and v.callable) then
            local s_Message = newMessage(PowNet.MESSAGE_TYPE.REGISTER, "RegisterCallable", {module = MODULENAME, name = k, params = v.params, installer = v.installer or false})
            PowNet.Send(MAINFRAME, s_Message, SERVER_PROTOCOL)
        end
    end
end
function UpdateModule(p_Module, p_Path)
    local s_Message = {
        type = MESSAGE_TYPE.UPDATE,
        ID = math.random(0, 2^30),
        dataKey = p_Module,
        data = false
    }

    local s_Response = sendAndWaitForResponse(MAINFRAME, s_Message, SERVER_PROTOCOL)
    if(p_Path == nil) then
        p_Path = "/" .. p_Module
    end

    -- NEVER TRUNCATE THE LIVE FILE BEFORE THE REPLACEMENT IS KNOWN GOOD.
    --
    -- This opened the destination with "w" -- which truncates immediately -- and only then wrote
    -- whatever had come back. So any bad fetch left an EMPTY module on disk, and when that module
    -- is PowNet itself the computer can never boot again to repair it: os.loadAPI fails, the
    -- bootloader dies before it runs anything, and the machine sits powered on doing nothing. The
    -- Bridge was bricked that way twice and had to be restored from the host filesystem by hand,
    -- which is exactly the kind of intervention a self-updating fleet is supposed to remove.
    --
    -- Validate, write to a scratch file, check what landed, and only then replace.
    if not s_Response then
        return false, "no reply from MainFrame for " .. tostring(p_Module)
    end
    if type(s_Response) ~= "string" then
        return false, ("MainFrame sent a %s for %s, not source"):format(type(s_Response), tostring(p_Module))
    end
    if s_Response == "InvalidName" then
        return false, "no module named " .. tostring(p_Module)
    end
    if #s_Response == 0 then
        return false, "MainFrame sent an empty " .. tostring(p_Module)
    end

    local s_Tmp = p_Path .. ".new"
    local s_Ok, s_Err = pcall(function()
        local h = fs.open(s_Tmp, "w")
        if h == nil then error("cannot open " .. s_Tmp) end
        h.write(s_Response)
        h.close()
    end)
    if not s_Ok then
        pcall(fs.delete, s_Tmp)
        return false, "could not stage " .. tostring(p_Module) .. ": " .. tostring(s_Err)
    end

    -- Confirm the bytes actually landed. A disk that is full fails HERE rather than after the
    -- live file has already been destroyed.
    local s_Size = 0
    pcall(function() s_Size = fs.getSize(s_Tmp) end)
    if s_Size < #s_Response then
        pcall(fs.delete, s_Tmp)
        return false, ("%s wrote %d of %d bytes -- disk full?"):format(tostring(p_Module), s_Size, #s_Response)
    end

    pcall(fs.delete, p_Path)
    local s_Moved, s_MoveErr = pcall(fs.move, s_Tmp, p_Path)
    if not s_Moved then
        return false, "could not install " .. tostring(p_Module) .. ": " .. tostring(s_MoveErr)
    end
    return true
end

-- Write-back of a module's DATA to MainFrame's VFS.
--
-- Before this, the ONLY persistence was the bootloader's write-back after a module exits. That
-- covers a clean shutdown and nothing else: a server stop, a chunk unload, or MainFrame
-- rebooting (which returns every module through the INIT id=0 path) dropped every drone
-- registration and every docking allocation. That is worse than losing state, because
-- registration is not idempotent -- DroneMan's lastDrone keeps counting and DockingMan's
-- freeSlot keeps advancing -- so a drone that survives a restart still holds a name and a slot
-- that the servers no longer believe they handed out.
local m_Dirty = false

-- Cheap and non-blocking on purpose. Handlers run inside main()'s receive loop while whoever
-- called them is counting down a 1s rednet timeout (3 tries, then it gives up). Saving
-- synchronously there spends a whole extra round-trip BEFORE the reply is sent, which is enough
-- to time the caller out -- and a drone that times out mid-registration is the exact failure
-- this is meant to prevent. So handlers only raise the flag; Update() does the writing.
function MarkDirty()
    m_Dirty = true
end

function Save()
    if(_G.DATA == nil or MODULENAME == nil or MAINFRAME == nil) then
        return false
    end
    local s_Saved = sendAndWaitForResponse(
        MAINFRAME, newMessage(MESSAGE_TYPE.SET, MODULENAME, _G.DATA), SERVER_PROTOCOL)
    if(s_Saved) then
        m_Dirty = false
        return true
    end
    -- Left dirty on purpose: the next message this module handles retries the write.
    print("Save failed, will retry")
    return false
end

function Update()
    -- After the reply, never before -- main() calls this once the handler's response is already
    -- on the wire, which is what makes the extra round-trip free as far as the caller is
    -- concerned.
    if(m_Dirty) then
        Save()
    end
    if(m_Update == nil) then
        return
    end
    m_Update()
end
-- Something to run before this module stands down for an update.
--
-- The INIT id=0 broadcast is how a fleet-wide update propagates: every module drops out of main,
-- the bootloader writes its DATA back and reboots, and the reboot pulls new code. That covers a
-- module's DATA and nothing else -- a drone halfway through a survey lost its task, and any scan
-- data it had not yet uploaded went with it.
--
-- The hook is the module's chance to flush and record where it got to.
local m_ShutdownHook

function SetShutdownHook(p_Fn)
    m_ShutdownHook = p_Fn
end

function RunShutdownHook(p_Reason)
    if m_ShutdownHook == nil then return end
    -- pcall: a failing hook must not stop the update, or one bad module wedges the whole fleet
    -- on the old version.
    local ok, err = pcall(m_ShutdownHook, p_Reason)
    if not ok then print("shutdown hook failed: " .. tostring(err)) end
end

-- Wait for a named service to actually be hosting before talking to it.
--
-- Boot order is not controllable: a fleet reload drops every machine at once and they come back
-- in whatever order the server happens to tick them. A module that assumes its dependency is
-- already up does not fail loudly -- it fails silently and then reports healthy. That is how
-- drones ended up holding names DroneMan had never issued, and how StorageMan sat in a reboot
-- loop looking fine.
--
-- Returns the id, or nil if it never appeared. nil means "genuinely absent" and callers should
-- treat it as a fault worth reporting, NOT as permission to carry on.
function WaitForService(p_Name, p_Seconds)
    local s_Waited, s_Limit = 0, (p_Seconds or 60)
    while s_Waited < s_Limit do
        local id = rednet.lookup(SERVER_PROTOCOL, p_Name)
        if id then
            if s_Waited > 0 then print("waited " .. s_Waited .. "s for " .. p_Name) end
            return id
        end
        os.sleep(2)
        s_Waited = s_Waited + 2
    end
    print("gave up waiting for " .. p_Name .. " after " .. s_Limit .. "s")
    return nil
end

-- Ask, and keep asking while the answer is "no reply".
--
-- sendAndWaitForResponse returns false both for "the service said no" and for "nothing answered".
-- Those mean opposite things and conflating them is what turned a boot race into a fleet that
-- silently disagreed with itself about who existed.
function AskInsisting(p_Service, p_Message, p_Tries)
    for attempt = 1, (p_Tries or 3) do
        local s_Res = sendAndWaitForResponse(p_Service, p_Message, SERVER_PROTOCOL)
        if s_Res ~= false then return s_Res, true end
        os.sleep(3)
    end
    return false, false      -- second return: false means "never got an answer at all"
end

function main()
    while true do
        print("Waiting for Server signal...")
        local serverID, serverMessage = rednet.receive(PowNet.SERVER_PROTOCOL)
        -- Skip replies. Every computer that makes a request also runs this loop, so without this
        -- the answer to our own question comes back round and gets dispatched as a new question.
        if type(serverMessage) == "table" and not serverMessage.reply then
            if(serverMessage.type == PowNet.MESSAGE_TYPE.INIT and serverMessage.ID == 0) then
                print("Server has been re-initialized. Ending execution.")
                do
                  -- Say WHO knocked us down and when. A module exiting here is by design, but it
                  -- is indistinguishable from a crash without this, and the whole fleet does it
                  -- at once whenever MainFrame reboots.
                  local h = fs.open("/exit-reason.txt", "w")
                  h.write(("INIT id=0 from %s at %s\n"):format(tostring(serverID), tostring(os.time())))
                  h.close()
                end
                RunShutdownHook("update")
                return
            end
            if(m_ServerEvents[serverMessage.dataKey] ~= nil) then
                print("Received: " .. serverMessage.dataKey)

                local s_Result, s_Response
                if(type(m_ServerEvents[serverMessage.dataKey]) == "function") then
                   s_Result, s_Response = m_ServerEvents[serverMessage.dataKey](serverID, serverMessage)
                elseif(type(m_ServerEvents[serverMessage.dataKey]) == "table") then
                    if(m_ServerEvents[serverMessage.dataKey].func == nil) then
                        print("Event registered, but pointing to nothing")
                    else
                        s_Result, s_Response = m_ServerEvents[serverMessage.dataKey].func(serverID, serverMessage)
                    end
                else
                    -- ANSWER "NO SUCH ENDPOINT" INSTEAD OF SAYING NOTHING.
                    --
                    -- This printed to a terminal nobody reads and fell through with s_Result still
                    -- nil, so no reply was sent -- which on the wire is indistinguishable from a
                    -- module that is wedged. A caller with a typo and a caller talking to a dead
                    -- module get identical silence, and the only way to tell them apart is to
                    -- already know the answer.
                    --
                    -- It cost real time today: a liveness probe asked StorageMan for "Stock" when
                    -- the endpoint is "GetStock", got silence, and reported a healthy module as
                    -- found-and-then-silent. The monitoring manufactured the exact fault it exists
                    -- to detect. The drone path below already answered properly; this one did not.
                    print("Unknown message handle: " .. tostring(serverMessage.dataKey))
                    s_Result, s_Response = false, "no such endpoint: " .. tostring(serverMessage.dataKey)
                end
                if(s_Result ~= nil) then
                    serverMessage.status = s_Result
                    serverMessage.data = s_Response
                    -- Tag it, so the receiver's dispatch loop knows to leave it alone. The waiting
                    -- caller matches on message ID and does not care about the type.
                    serverMessage.reply = true
                    rednet.send(serverID, serverMessage, SERVER_PROTOCOL)
                end
            else
                -- Was `dataKey .. type` with no separator, which rendered as "GetPath5" and read
                -- like a corrupted event name rather than "GetPath, message type 5". Naming the
                -- module that refused is the actually useful part: this error always means the
                -- message reached the WRONG module, so the question is which one it landed on.
                print(("No handler for %q (type %s) on %s")
                    :format(tostring(serverMessage.dataKey), tostring(serverMessage.type),
                            tostring(os.getComputerLabel() or os.getComputerID())))
            end
        end
        Update()
    end
end

function droneMain()
    while true do
        print("Waiting for Drone signal...")
        local droneID, droneMessage = rednet.receive(PowNet.DRONE_PROTOCOL)
        -- Same reason as PowNet.main: our own answers come back round this loop otherwise.
        if type(droneMessage) == "table" and not droneMessage.reply then
           --if(droneMessage.type == PowNet.MESSAGE_TYPE.INIT and droneID.ID == 0) then
           --    print("Server has been initialized. Rebooting and performing updates.")
           --    Save()
           --    os.reboot()
           --end
            if(m_DroneEvents[droneMessage.dataKey] ~= nil) then
                print("Received: " .. droneMessage.dataKey)
                -- Declared HERE, not inside the branches.
                --
                -- `local s_Result` inside an if-branch dies at the end of that branch, so the test
                -- below read a nil GLOBAL and no drone ever replied to anything -- every order was
                -- fire-and-forget whatever the handler returned. The caller cannot tell "done"
                -- from "refused" from "never arrived", which is precisely the ambiguity that made
                -- a silently-failing GoTo impossible to diagnose.
                local s_Result, s_Response
                -- pcall, because a handler that throws must not take the drone's whole message
                -- loop down with it. Without this one bad order deafens the drone permanently.
                local s_Handler = m_DroneEvents[droneMessage.dataKey]
                if(type(s_Handler) == "function") then
                    local ok, a, b = pcall(s_Handler, droneID, droneMessage)
                    if ok then s_Result, s_Response = a, b
                    else s_Result, s_Response = false, tostring(a) print("handler error: " .. tostring(a)) end
                elseif(type(s_Handler) == "table") then
                    if(s_Handler.func == nil) then
                        print("Event registered, but pointing to nothing")
                        s_Result, s_Response = false, "event registered but pointing to nothing"
                    else
                        local ok, a, b = pcall(s_Handler.func, droneID, droneMessage)
                        if ok then s_Result, s_Response = a, b
                        else s_Result, s_Response = false, tostring(a) print("handler error: " .. tostring(a)) end
                    end
                else
                    print("Unknown drone message handle")
                    s_Result, s_Response = false, "unknown drone message handle"
                end
                if(s_Result ~= nil) then
                    droneMessage.status = s_Result
                    droneMessage.data = s_Response
                    droneMessage.reply = true   -- see MESSAGE_TYPE.RESPONSE
                    rednet.send(droneID, droneMessage, DRONE_PROTOCOL)
                end
            else
                print("No drone event with the name: " .. droneMessage.dataKey)
            end
        end
        Update()
    end
end

function Send(p_Recipient, p_Message, p_Protocol)
    local s_RecipientID = p_Recipient
    if(type(p_Recipient) == "string") then
        s_RecipientID = PowNet.Lookup(p_Recipient)
        if(s_RecipientID == nil or s_RecipientID == os.getComputerID()) then
            print("Could not find server: " .. p_Recipient)
            return false
        end
    end
    rednet.send(s_RecipientID, p_Message, p_Protocol)
    return true, s_RecipientID
end

function SendToServer(p_ServerName, p_Message, p_Protocol)
    if(p_Protocol == nil) then
        p_Protocol = SERVER_PROTOCOL
    end
    return Send(p_ServerName, p_Message, p_Protocol)
end

function SendToDrone(p_DroneID, p_Message, p_Protocol)
    if(p_Protocol == nil) then
        p_Protocol = DRONE_PROTOCOL
    end
    return Send(p_DroneID, p_Message, p_Protocol)
end
function SendToAllDrones(p_Message)
    rednet.broadcast(p_Message, DRONE_PROTOCOL)
    return true
end

-- p_Timeout, because ONE SECOND is not a universal answer.
--
-- Every call in the fleet waited REDNET_TIMEOUT (1s) and retried three times. That is generous for
-- "what is in the chest" and hopeless for MapServer.a_star, which searches thousands of cells in
-- interpreted Lua: the reply never arrived inside a second, each retry made the server start the
-- same expensive search AGAIN, and the caller concluded there was no path. Recalling D3 failed this
-- way -- reported as "GoTo FAILED: nil" -- while a perfectly good route existed.
function sendAndWaitForResponse(p_Recipient, message, protocol, p_Timeout)
    if(p_Recipient == -1) then
        p_Recipient = MAINFRAME
    end
    if(protocol == nil) then
        protocol = SERVER_PROTOCOL
    end
    local s_Timeout = p_Timeout or REDNET_TIMEOUT

    local s_Status, s_RecipientID = Send(p_Recipient, message, protocol)
    if(s_Status == false) then
        -- The name did not resolve. Drop it so the next attempt asks the network again rather
        -- than failing identically for ever off a stale cache.
        Forget(p_Recipient)
        return false, "Failed to send message"
    end
    local attemptNumber = 1
    while true do
        local senderID, reply = rednet.receive(protocol, s_Timeout)
        if senderID == s_RecipientID and reply.ID == message.ID then
            -- AN ANSWER WITH NO PAYLOAD IS STILL AN ANSWER.
            --
            -- This returned reply.data and nothing else, so a handler that ends `return true` --
            -- succeeded, nothing to report -- came back as nil, which is the SAME value this
            -- function returns for "nobody replied". The caller cannot tell a healthy exchange
            -- from silence, and every caller in the fleet reads nil as unreachable.
            --
            -- That is what OnHeartbeat did. DroneMan received and processed every single
            -- heartbeat, kept its registry current, and answered every one -- while each drone
            -- concluded the tower could not hear it, logged "tower unreachable", counted a miss,
            -- and eventually flew RecoverLink() back down its own breadcrumbs to re-establish a
            -- link that had never once dropped. Weeks of "the drones keep going offline" was this
            -- line: they were never offline, they were being told so by their own return value.
            --
            -- So fall back to the status flag when there is no payload. Endpoints that answer with
            -- data are untouched; endpoints that answer `true` now say true instead of nothing.
            if reply.data == nil and reply.status ~= nil then return reply.status end
            return reply.data
        elseif not senderID then
            if attemptNumber < 3 then
                rednet.send(s_RecipientID, message, protocol)
                attemptNumber = attemptNumber + 1
            else
                -- Three silent attempts against a module that should be there: assume the id is
                -- wrong rather than the module dead, and make the next call re-resolve it.
                Forget(p_Recipient)
                return false
            end
        end
    end
end

function dump(o)
    if(o == nil) then
        print("tried to load jack shit")
    end
    if type(o) == 'table' then
        local s = '{ '
        for k,v in pairs(o) do
            -- A COPY, not the loop variable. Assigning to a for control variable is rejected
            -- outright by Lua 5.4, which is what `luac -p` on this machine is -- so this one line
            -- made the fleet's most load-bearing file the only one no syntax check could ever
            -- read. CC's Lua accepts it, so it never failed in world; it just silently opted
            -- PowNet out of every guard the repo has.
            local s_Key = k
            if type(s_Key) ~= 'number' then s_Key = '"'..s_Key..'"' end
            s = s .. '['..s_Key..'] = ' .. dump(v) .. ','
        end
        return s .. '} '
    else
        return tostring(o)
    end
end

