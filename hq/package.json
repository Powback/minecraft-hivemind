{
  "name": "hive-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-esbuild-platforms.mjs && tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "node scripts/ensure-esbuild-platforms.mjs && tsx src/tools/core.test.ts && vitest run",
    "fix:platforms": "node scripts/ensure-esbuild-platforms.mjs",
    "lint:complexity": "node scripts/complexity.mjs",
    "lint:complexity:update": "node scripts/complexity.mjs --update"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
